# Public (exposed to the browser bundle). Never put secrets in VITE_* variables.
# Absolute production origin, used for canonical and hreflang URLs. Leave empty in dev.
VITE_SITE_URL=

# Public URL of the inquiry endpoint (serverless function or managed form service).
# Leave empty to run the form in clearly labelled demo mode (nothing is sent).
VITE_INQUIRY_ENDPOINT=

# Server-side only (Phase 4 — serverless inquiry endpoint). Not read by the frontend.
# EMAIL_PROVIDER_API_KEY=
# INQUIRY_RECIPIENT_EMAIL=
